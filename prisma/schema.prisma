// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ArtworkStatus {
  AVAILABLE
  SOLD
  RESERVED
  DRAFT
}

enum EmailJobKind {
  WELCOME
  PASSWORD_RESET
  PASSWORD_CHANGED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  EXPIRED
}

// ─── Authentication ───────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  passwordHash   String   @map("password_hash")
  displayName    String?  @map("display_name")
  avatarUrl      String?  @map("avatar_url")
  sessionVersion Int      @default(0) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailJobs           EmailJob[]

  @@map("users")
}

model PasswordResetToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  invalidatedAt DateTime? @map("invalidated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs EmailJob[]

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailJob {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  resetTokenId     String?        @map("reset_token_id") @db.Uuid
  kind             EmailJobKind
  status           EmailJobStatus @default(PENDING)
  idempotencyKey   String         @unique @map("idempotency_key")
  encryptedPayload Bytes?         @map("encrypted_payload")
  payloadKeyId     String?        @map("payload_key_id")
  attempts         Int            @default(0)
  availableAt      DateTime       @default(now()) @map("available_at")
  expiresAt        DateTime       @map("expires_at")
  leaseId          String?        @map("lease_id") @db.Uuid
  leaseExpiresAt   DateTime?      @map("lease_expires_at")
  lastErrorCode    String?        @map("last_error_code")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resetToken PasswordResetToken? @relation(fields: [resetTokenId], references: [id], onDelete: SetNull)

  @@index([status, availableAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([userId])
  @@index([resetTokenId])
  @@map("email_jobs")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid @map("user_id")
  familyId     String    @db.Uuid @map("family_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  replacedById String?   @db.Uuid @map("replaced_by_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─── Artist ───────────────────────────────────────────────────────────────────

model Artist {
  id         BigInt   @id @default(autoincrement())
  name       String
  country    String?
  birthYear  Int?     @map("birth_year")
  deathYear  Int?     @map("death_year")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  artworks ArtworkArtist[]

  @@index([name])
  @@index([country])
  @@map("artist")
}

// ─── Artwork ──────────────────────────────────────────────────────────────────

model Artwork {
  id        BigInt        @id @default(autoincrement())
  title     String
  yearMade  Int?          @map("year_made")
  price     Decimal?      @db.Decimal(12, 2)
  currency  String?
  width     Decimal?      @db.Decimal(10, 2)
  height    Decimal?      @db.Decimal(10, 2)
  depth     Decimal?      @db.Decimal(10, 2)
  status    ArtworkStatus @default(DRAFT)
  featured  Boolean       @default(false)
  details   Json?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  artists      ArtworkArtist[]
  artworkTypes ArtworkArtworkType[]
  materials    ArtworkMaterial[]
  images       ArtworkImage[]

  @@index([status])
  @@index([price])
  @@index([featured])
  @@index([yearMade])
  @@map("artwork")
}

// ─── Artwork Image ───────────────────────────────────────────────────────────

model ArtworkImage {
  id               BigInt   @id @default(autoincrement())
  artworkId        BigInt   @map("artwork_id")
  objectKey        String   @map("object_key")
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  altText          String?  @map("alt_text")
  sortOrder        Int      @default(0) @map("sort_order")
  isPrimary        Boolean  @default(false) @map("is_primary")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([artworkId, objectKey])
  @@index([artworkId, sortOrder])
  @@index([artworkId, isPrimary])
  @@map("artwork_image")
}

// ─── Artwork Type ─────────────────────────────────────────────────────────────

model ArtworkType {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  materials    Material[]
  artworks     ArtworkArtworkType[]

  @@map("artwork_type")
}

// ─── Material ─────────────────────────────────────────────────────────────────

model Material {
  id            BigInt      @id @default(autoincrement())
  artworkTypeId BigInt      @map("artwork_type_id")
  name          String
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  artworkType ArtworkType       @relation(fields: [artworkTypeId], references: [id])
  artworks    ArtworkMaterial[]

  @@unique([artworkTypeId, name])
  @@map("material")
}

// ─── Junction: Artwork ↔ Artist ───────────────────────────────────────────────

model ArtworkArtist {
  artworkId BigInt @map("artwork_id")
  artistId  BigInt @map("artist_id")

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  artist  Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([artworkId, artistId])
  @@index([artworkId])
  @@index([artistId])
  @@map("artwork_artist")
}

// ─── Junction: Artwork ↔ ArtworkType ─────────────────────────────────────────

model ArtworkArtworkType {
  artworkId     BigInt @map("artwork_id")
  artworkTypeId BigInt @map("artwork_type_id")

  artwork     Artwork     @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  artworkType ArtworkType @relation(fields: [artworkTypeId], references: [id], onDelete: Cascade)

  @@id([artworkId, artworkTypeId])
  @@index([artworkId])
  @@index([artworkTypeId])
  @@map("artwork_artwork_type")
}

// ─── Junction: Artwork ↔ Material ────────────────────────────────────────────

model ArtworkMaterial {
  artworkId  BigInt @map("artwork_id")
  materialId BigInt @map("material_id")

  artwork  Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([artworkId, materialId])
  @@index([artworkId])
  @@index([materialId])
  @@map("artwork_material")
}
