# ─── Local standalone environment template ───────────────────────────────────
# Copy this file to .env or .env.local and fill in your values.
# PostgreSQL is expected to run via development-environment on host port 5433.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://artwork_db_user:artwork_db_password@127.0.0.1:5433/artwork_db
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USERNAME=artwork_db_user
DATABASE_PASSWORD=artwork_db_password
DATABASE_NAME=artwork_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=local-access-secret-change-before-production
JWT_REFRESH_SECRET=local-refresh-secret-change-before-production
JWT_ISSUER=artworkapp-api
JWT_AUDIENCE=artworkapp-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ── Stripe (use test keys for local dev) ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whec_placeholder

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.placeholder
FROM_EMAIL=dev@example.com

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=artwork-local-bucket

# ── Object storage (MinIO for local development) ─────────────────────────────
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minio_root_username
OBJECT_STORAGE_SECRET_KEY=minio_root_secret_password
OBJECT_STORAGE_BUCKET=artwork-images
ALLOW_DEV_SEED=false

# ── Application ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
