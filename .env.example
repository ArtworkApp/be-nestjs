# ─── Local standalone environment template ───────────────────────────────────
# Copy this file to .env and fill in your values.
# PostgreSQL must be running locally (or adjust DATABASE_URL accordingly).

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artwork_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=artwork_db

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Stripe (use test keys for local dev) ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.placeholder
FROM_EMAIL=dev@example.com

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=artwork-local-bucket

# ── Application ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
