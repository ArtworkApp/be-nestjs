# Dev container database connection (development-environment/.devcontainer/docker-compose.yml)
DATABASE_URL=postgresql://artwork_db_user:artwork_db_password@127.0.0.1:5433/artwork_db
DATABASE_CREDENTIAL=<db_user>:<db_password>

# Object storage (MinIO in development-environment)
OBJECT_STORAGE_URL=http://minio:9000
OBJECT_STORAGE_KEY=<minio_access_key>:<minio_secret_key>

# NestJS runtime variables
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USERNAME=artwork_db_user
DATABASE_PASSWORD=artwork_db_password
DATABASE_NAME=artwork_db

JWT_SECRET=<jwt_secret>
JWT_EXPIRES_IN=7d

STRIPE_SECRET_KEY=<stripe_secret_key>
STRIPE_WEBHOOK_SECRET=<stripe_webhook_secret>

SENDGRID_API_KEY=<sendgrid_api_key>
FROM_EMAIL=<from_email>

AWS_REGION=us-east-1
AWS_S3_BUCKET=<bucket_name>

PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
